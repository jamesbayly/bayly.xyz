---
import { getCollection } from "astro:content"
import Layout from "@/layouts/main.astro"

export async function getStaticPaths() {
  const posts = await getCollection("posts")

  function getTags(data: { tag?: string | string[]; tags?: string | string[] }): string[] {
    const raw = data.tags ?? data.tag ?? []
    return Array.isArray(raw) ? raw : [raw]
  }

  // Build map: slug → canonical tag name
  const tagMap = new Map<string, string>()
  posts.forEach((post) => {
    getTags(post.data).forEach((tag) => {
      const slug = tag.toLowerCase().replace(/\s+/g, "-")
      if (!tagMap.has(slug)) tagMap.set(slug, tag)
    })
  })

  return [...tagMap.entries()].map(([slug, tagName]) => {
    const filtered = posts
      .filter((p) => getTags(p.data).some((t) => t.toLowerCase().replace(/\s+/g, "-") === slug))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    return { params: { tag: slug }, props: { tagName, posts: filtered } }
  })
}

const { tagName, posts } = Astro.props

function getTags(data: { tag?: string | string[]; tags?: string | string[] }): string[] {
  const raw = data.tags ?? data.tag ?? []
  return Array.isArray(raw) ? raw : [raw]
}

const container = "mx-auto w-[min(1180px,calc(100%-36px))] md:w-[min(1180px,calc(100%-48px))]"
---

<Layout
  title={`${tagName} – James Bayly`}
  description={`Travel essays tagged "${tagName}" by James Bayly.`}
>
  <div class="min-h-svh bg-white text-brand-ink">
    <header class="border-b border-brand-line bg-white">
      <div class={`${container} flex h-[64px] items-center justify-between`}>
        <a href="/" class="font-heading text-[1.1rem] font-extrabold tracking-[0.11em] no-underline">JAMES BAYLY</a>
        <nav class="flex items-center gap-6">
          <a href="/" class="text-sm font-semibold no-underline hover:text-brand-deep">Home</a>
          <a href="/blog" class="text-sm font-semibold no-underline hover:text-brand-deep">Blog</a>
        </nav>
      </div>
    </header>

    <section class="bg-brand-ink py-14 text-white md:py-20">
      <div class={container}>
        <a href="/blog" class="mb-4 inline-block text-xs font-semibold text-brand-aqua/70 no-underline hover:text-brand-aqua">← All posts</a>
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.13em] text-brand-aqua">Tag</p>
        <h1 class="font-heading text-[clamp(2rem,5vw,3.5rem)] font-medium leading-[1.01] tracking-[-0.07em]">{tagName}</h1>
        <p class="mt-2 text-sm text-white/60">{posts.length} {posts.length === 1 ? "post" : "posts"}</p>
      </div>
    </section>

    <main class={`${container} py-14 md:py-20`}>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => {
          const tags = getTags(post.data)
          const date = post.data.date.toLocaleDateString("en-NZ", { year: "numeric", month: "long", day: "numeric" })
          return (
            <article class="group flex flex-col overflow-hidden border border-brand-line bg-white">
              {post.data.cover && (
                <a href={`/blog/${post.id}`} class="block overflow-hidden">
                  <img
                    src={post.data.cover}
                    alt={post.data.title}
                    class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="flex flex-1 flex-col p-5">
                <div class="mb-3 flex flex-wrap gap-1.5">
                  {tags.map((t) => (
                    <span class="bg-brand-aqua-soft px-2 py-0.5 text-[0.62rem] font-bold uppercase tracking-[0.08em] text-brand-deep">{t}</span>
                  ))}
                </div>
                <h2 class="mb-2 font-heading text-lg font-semibold leading-[1.2] tracking-[-0.04em]">
                  <a href={`/blog/${post.id}`} class="no-underline hover:text-brand-deep">{post.data.title}</a>
                </h2>
                <p class="mt-auto pt-3 text-xs text-brand-muted">{date}</p>
              </div>
            </article>
          )
        })}
      </div>
    </main>

    <footer class="border-t border-brand-line bg-brand-ink py-6 text-white/65">
      <div class={`${container} flex flex-col gap-2 text-sm md:flex-row md:items-center md:justify-between`}>
        <p><strong class="font-heading text-xs tracking-[0.08em] text-white">JAMES BAYLY</strong> · Perspectives from the road</p>
        <a href="/blog/rss.xml" class="text-xs text-white/50 no-underline hover:text-white/80">RSS Feed</a>
        <p>© {new Date().getFullYear()} James Bayly</p>
      </div>
    </footer>
  </div>
</Layout>
