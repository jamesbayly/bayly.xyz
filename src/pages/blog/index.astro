---
import { getCollection } from "astro:content"
import Layout from "@/layouts/main.astro"

const allPosts = await getCollection("posts")

// Normalise tag/tags → allTags array
function getTags(data: { tag?: string | string[]; tags?: string | string[] }): string[] {
  const raw = data.tags ?? data.tag ?? []
  return Array.isArray(raw) ? raw : [raw]
}

// Sort newest first
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

// Collect all unique tags for the sidebar
const allTags = [...new Set(posts.flatMap((p) => getTags(p.data)))].sort()

const container = "mx-auto w-[min(1180px,calc(100%-36px))] md:w-[min(1180px,calc(100%-48px))]"
---

<Layout
  title="Perspectives by James Bayly – Travel essays and photography"
  description="A collection of travel essays and photography from the road, by James Bayly."
>
  <div class="min-h-svh bg-white text-brand-ink">
    <!-- Nav bar -->
    <header class="border-b border-brand-line bg-white">
      <div class={`${container} flex h-[64px] items-center justify-between`}>
        <a href="/" class="font-heading text-[1.1rem] font-extrabold tracking-[0.11em] no-underline">
          JAMES BAYLY
        </a>
        <nav class="flex items-center gap-6">
          <a href="/" class="text-sm font-semibold no-underline hover:text-brand-deep">Home</a>
          <a href="/blog" class="text-sm font-semibold text-brand-deep no-underline">Blog</a>
        </nav>
      </div>
    </header>

    <!-- Page hero -->
    <section class="bg-brand-ink py-16 text-white md:py-24">
      <div class={container}>
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.13em] text-brand-aqua">Perspectives</p>
        <h1 class="font-heading text-[clamp(2.4rem,6vw,4.5rem)] font-medium leading-[1.01] tracking-[-0.07em]">
          From the road.
        </h1>
        <p class="mt-4 max-w-[520px] text-base leading-relaxed text-white/70">
          Travel essays and photography from James Bayly - places, people and the peculiar ideas they provoke.
        </p>
      </div>
    </section>

    <!-- Tag filter strip -->
    {allTags.length > 0 && (
      <section class="border-b border-brand-line bg-brand-surface py-4">
        <div class={`${container} flex flex-wrap gap-2`}>
          <a
            href="/blog"
            class="border border-brand-line bg-white px-3 py-1 text-xs font-semibold text-brand-ink no-underline hover:border-brand-deep hover:text-brand-deep"
          >
            All
          </a>
          {allTags.map((tag) => (
            <a
              href={`/blog/tags/${encodeURIComponent(tag.toLowerCase().replace(/\s+/g, "-"))}`}
              class="border border-brand-line bg-white px-3 py-1 text-xs font-semibold text-brand-muted no-underline hover:border-brand-deep hover:text-brand-deep"
            >
              {tag}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Post grid -->
    <main class={`${container} py-14 md:py-20`}>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => {
          const tags = getTags(post.data)
          const date = post.data.date.toLocaleDateString("en-NZ", { year: "numeric", month: "long", day: "numeric" })
          return (
            <article class="group flex flex-col overflow-hidden border border-brand-line bg-white">
              {post.data.cover && (
                <a href={`/blog/${post.id}`} class="block overflow-hidden">
                  <img
                    src={post.data.cover}
                    alt={post.data.title}
                    class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="flex flex-1 flex-col p-5">
                {tags.length > 0 && (
                  <div class="mb-3 flex flex-wrap gap-1.5">
                    {tags.map((tag) => (
                      <span class="bg-brand-aqua-soft px-2 py-0.5 text-[0.62rem] font-bold uppercase tracking-[0.08em] text-brand-deep">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
                <h2 class="mb-2 font-heading text-lg font-semibold leading-[1.2] tracking-[-0.04em]">
                  <a href={`/blog/${post.id}`} class="no-underline hover:text-brand-deep">
                    {post.data.title}
                  </a>
                </h2>
                {post.data.description && (
                  <p class="mb-3 text-sm leading-relaxed text-brand-muted">{post.data.description}</p>
                )}
                <p class="mt-auto pt-3 text-xs text-brand-muted">{date}</p>
              </div>
            </article>
          )
        })}
      </div>
    </main>

    <footer class="border-t border-brand-line bg-brand-ink py-6 text-white/65">
      <div class={`${container} flex flex-col gap-2 text-sm md:flex-row md:items-center md:justify-between`}>
        <p><strong class="font-heading text-xs tracking-[0.08em] text-white">JAMES BAYLY</strong> · Perspectives from the road</p>
        <a href="/blog/rss.xml" class="text-xs text-white/50 no-underline hover:text-white/80">RSS Feed</a>
        <p>© {new Date().getFullYear()} James Bayly</p>
      </div>
    </footer>
  </div>
</Layout>
