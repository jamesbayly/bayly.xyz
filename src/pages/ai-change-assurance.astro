---
import Layout from "@/layouts/main.astro"
import Header from "@/components/Header"
import ButtonLink from "@/components/ButtonLink"
import {
  ArrowDownRight,
  ArrowRight,
  Check,
  CircleAlert,
  Database,
  Gauge,
  ShieldCheck,
  Waypoints,
} from "lucide-react"

const container =
  "mx-auto w-[min(1180px,calc(100%-36px))] md:w-[min(1180px,calc(100%-48px))]"
const sectionKicker =
  "mb-6 text-[0.69rem] font-bold uppercase tracking-[0.13em] text-brand-deep"
const sectionHeading =
  "font-heading text-[clamp(2.3rem,4.5vw,4.35rem)] leading-[1.01] font-medium tracking-[-0.07em] text-brand-ink"

const futureCapabilities = [
  [
    "Living assurance corpus",
    "Convert approved, anonymised production observations into a maintained test corpus. Administrators can inspect, edit, approve or retire every case.",
  ],
  [
    "Every material change",
    "Extend from models to prompts, retrieval, tools, application code, provider changes and changed input populations.",
  ],
  [
    "Continuous evidence",
    "Connect evaluation history, approvals, exceptions and post-release behaviour so the next change takes hours to assess, not weeks.",
  ],
]
---

<Layout
  title="AI Change Assurance | James Bayly"
  description="AI Change Assurance helps teams prove whether a production AI workload can move to a better or cheaper model without breaking the business."
  canonical="https://bayly.xyz/ai-change-assurance/"
  robots="noindex, nofollow, noarchive"
>
  <div class="min-h-svh overflow-hidden bg-white text-brand-ink">
    <Header client:load />

    <main id="top">
      <section
        class="relative overflow-hidden bg-brand-aqua-soft pt-[132px] pb-20 md:pt-[170px] md:pb-28"
      >
        <div
          class="absolute top-[-18%] right-[-12%] aspect-square w-[57%] rounded-full border border-brand-deep/20"
        >
        </div>
        <div
          class="absolute right-[9%] bottom-[-41%] aspect-square w-[42%] rounded-full border border-brand-deep/20"
        >
        </div>
        <div
          class={`${container} relative z-10 grid items-end gap-12 md:grid-cols-[1.15fr_.85fr] md:gap-16`}
        >
          <div class="max-w-[780px]">
            <h1
              class="mb-7 font-heading text-[clamp(3rem,8vw,6.3rem)] leading-[0.94] font-medium tracking-[-0.078em] text-brand-ink"
            >
              Change your AI without <em
                class="font-serif font-normal text-brand-deep">breaking</em
              > the business.
            </h1>
            <p
              class="max-w-[650px] text-[1.04rem] leading-relaxed text-brand-muted md:text-[1.18rem]"
            >
              AI Change Assurance automatically turns production workloads into a living
              regression suite, helps you evaluate a proposed model change against your
              business requirements, and gives you the evidence to swap, change,
              or stay with your existing model.
            </p>
            <div
              class="mt-9 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-7"
            >
              <ButtonLink href="#conversation" size="lg">
                Talk through a workload <ArrowRight className="size-4" />
              </ButtonLink>
              <a
                href="#phase-one"
                class="inline-flex items-center gap-2 text-sm font-bold no-underline hover:text-brand-deep"
              >
                See the first engagement <ArrowDownRight className="size-4" />
              </a>
            </div>
          </div>

          <aside
            class="border border-brand-deep/20 bg-white/85 p-6 shadow-[0_16px_45px_rgba(13,94,122,0.08)] backdrop-blur-sm md:p-8"
          >
            <p
              class="mb-8 text-[0.68rem] font-bold tracking-[0.13em] text-brand-deep uppercase"
            >
              The question it answers
            </p>
            <p
              class="font-heading text-[clamp(1.65rem,3vw,2.3rem)] leading-[1.05] font-medium tracking-[-0.055em]"
            >
              Can we move this production AI workload to a better or cheaper
              model safely?
            </p>
            <div class="mt-8 border-t border-brand-line pt-5">
              <p class="text-sm leading-relaxed text-brand-muted">
                Not an observability dashboard. Not a model router. A decision
                process that considers quality, risk, reliability and economics
                before production changes.
              </p>
            </div>
          </aside>
        </div>
      </section>

      <section class="bg-brand-ink py-12 text-white md:py-16">
        <div class={`${container} grid gap-7 md:grid-cols-3 md:gap-12`}>
          <div>
            <p
              class="font-heading text-3xl font-medium tracking-[-0.065em] text-brand-aqua"
            >
              Monitor Drift
            </p>
            <p class="mt-2 text-sm leading-relaxed text-white/70">
              Automatically run regression suites on production workloads at regular intervals to detect drift, regressions and critical failures.
            </p>
          </div>
          <div>
            <p
              class="font-heading text-3xl font-medium tracking-[-0.065em] text-brand-aqua"
            >
              Compare Alternatives
            </p>
            <p class="mt-2 text-sm leading-relaxed text-white/70">
              Compare the current model choice and credible alternatives under
              identical conditions with quantitative metrics.
            </p>
          </div>
          <div>
            <p
              class="font-heading text-3xl font-medium tracking-[-0.065em] text-brand-aqua"
            >
              Optimise Cost and Quality
            </p>
            <p class="mt-2 text-sm leading-relaxed text-white/70">
              Quantify the likely cost and quality impact of a model change before
              you switch with real data, and avoid expensive surprises.
            </p>
          </div>
        </div>
      </section>


      <section class="bg-brand-cream py-20 md:py-32">
        <div
          class={`${container} grid gap-10 md:grid-cols-[.8fr_1.2fr] md:gap-24`}
        >
          <div>
            <p class={sectionKicker}>How it works</p>
            <h2 class={sectionHeading}>Automatically collect evidence before the change.</h2>
            <p
              class="mt-6 max-w-[380px] text-base leading-relaxed text-brand-muted"
            >
              The product is designed to answer three questions clearly: can we
              change this model safely, what evidence supports the decision,
              and did the released model behave as expected?
            </p>
          </div>
          <ol class="border-t border-brand-line">
            {
              [
  [
    "01",
    "Connect",
    "Proxy your production AI requests through our platform or export your existing traces. The system captures the inputs, cost, and final response.",
  ],
  [
    "02",
    "Baseline",
    "Run the production system as is. Our product automatically establishes how the system behaves by collecting anonymised samples of inputs and outputs.",
  ],
  [
    "03",
    "Monitor",
    "As the system runs, the product automatically collects metadata on cost, requests, responses and failures. It periodically runs a regression suite on a schedule to detect drift.",
  ],
  [
    "04",
    "Evaluate",
    "Run two to four candidates through the same test suite using deterministic checks, calibrated model-based judges and targeted human review.",
  ],
  [
    "05",
    "Compare",
    "Inspect quality, critical failures, latency, reliability and cost with clear quantitative metrics.",
  ],
  [
    "06",
    "Decide",
    "Receive a decision-ready recommendation for model changes, migration plan and thresholds for validating the approved change in production.",
  ],
].map(([number, title, copy]) => (
                <li class="grid grid-cols-[42px_1fr] gap-4 border-b border-brand-line py-6 md:grid-cols-[70px_1fr] md:gap-6">
                  <span class="text-xs font-bold text-brand-deep">
                    {number}
                  </span>
                  <div>
                    <h3 class="mb-2 font-heading text-xl font-semibold tracking-[-0.045em]">
                      {title}
                    </h3>
                    <p class="max-w-[610px] text-sm leading-relaxed text-brand-muted">
                      {copy}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="bg-brand-deep py-20 text-white md:py-32">
        <div
          class={`${container} grid gap-9 md:grid-cols-[.78fr_1.22fr] md:gap-24`}
        >
          <div>
            <p
              class="mb-6 text-[0.69rem] font-bold tracking-[0.13em] text-brand-aqua uppercase"
            >
              Why it is credible
            </p>
            <h2
              class="font-heading text-[clamp(2.3rem,4.5vw,4.35rem)] leading-[1.01] font-medium tracking-[-0.07em]"
            >
              The evaluation should be as rigorous as the decision.
            </h2>
          </div>
          <div class="grid border-t border-l border-white/20 sm:grid-cols-2">
            {
              [
  [
    "A decision, not a dashboard",
    "The output is evidence for a specific engineering decision: to swap, change, or stay with your existing model.",
  ],
  [
    "Real test cases, not a generic benchmark",
    "The testing suite creates itself from real inputs and outputs, signals that that matter to your team.",
  ],
  [
    "Human accountability stays in the loop",
    "The system can recommend and record. The people accountable for the workload approve the change.",
  ],
  [
    "Compatible with your Model Platform",
    "Sits in between your existing model platform, OpenAI, Anthropic, Azure Foundry, OpenRouter.",
  ],
].map(([title, copy], index) => (
                <article class="min-h-[220px] border-r border-b border-white/20 p-6 md:min-h-[250px]">
                  {index === 0 && <Gauge className="size-5 text-brand-aqua" />}
                  {index === 1 && (
                    <Database className="size-5 text-brand-aqua" />
                  )}
                  {index === 2 && (
                    <ShieldCheck className="size-5 text-brand-aqua" />
                  )}
                  {index === 3 && (
                    <Waypoints className="size-5 text-brand-aqua" />
                  )}
                  <h3 class="mt-10 mb-3 font-heading text-xl font-medium tracking-[-0.05em]">
                    {title}
                  </h3>
                  <p class="text-sm leading-relaxed text-white/70">{copy}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="py-20 md:py-32">
        <div
          class={`${container} grid gap-10 md:grid-cols-[.75fr_1.25fr] md:gap-24`}
        >
          <div>
            <p class={sectionKicker}>Where it can lead</p>
            <h2 class={sectionHeading}>
              A living acceptance suite for every material change.
            </h2>
          </div>
          <div class="max-w-[700px]">
            <p class="text-lg leading-relaxed text-brand-muted">
              The first engagement proves one model change. The longer-term
              outcome is a maintained, customer-specific assurance asset that
              makes every future change faster and more accountable.
            </p>
            <p class="mt-5 text-base leading-relaxed text-brand-muted">
              Production observations can become anonymised, versioned candidate
              test cases. They are never accepted as truth by default. An
              authorised administrator can inspect, edit, approve or reject the
              expected behaviour and the test rules behind each case.
            </p>
          </div>
        </div>

        <div
          class={`${container} mt-12 grid border-t border-l border-brand-line md:mt-20 md:grid-cols-3`}
        >
          {
            futureCapabilities.map(([title, copy], index) => (
              <article class="min-h-[245px] border-r border-b border-brand-line p-6 md:min-h-[285px]">
                <span class="text-xs font-bold text-brand-deep">
                  0{index + 1}
                </span>
                <h3 class="mt-12 mb-4 font-heading text-xl font-semibold tracking-[-0.05em]">
                  {title}
                </h3>
                <p class="text-sm leading-relaxed text-brand-muted">{copy}</p>
              </article>
            ))
          }
        </div>
      </section>


      <section class="bg-brand-aqua-soft py-20 md:py-32">
        <div
          class={`${container} grid gap-10 md:grid-cols-[.8fr_1.2fr] md:gap-24`}
        >
          <div>
            <p class={sectionKicker}>Claims discipline</p>
            <h2 class={sectionHeading}>
              Useful evidence for future compliance concerns.
            </h2>
          </div>
          <div class="max-w-[700px]">
            <p class="text-lg leading-relaxed text-brand-muted">
              The product can produce operational evidence that supports
              applicable monitoring, logging and change-assurance processes required under the EU AI Act, NIST AI RMF or ISO/IEC 42001.
            </p>
          </div>
        </div>
      </section>

      <section
        id="conversation"
        class="bg-brand-deep py-20 text-white md:py-32"
      >
        <div
          class={`${container} grid gap-10 md:grid-cols-[.8fr_1.2fr] md:gap-24`}
        >
          <div>
            <p
              class="mb-6 text-[0.69rem] font-bold tracking-[0.13em] text-brand-aqua uppercase"
            >
              Design partners
            </p>
            <h2
              class="font-heading text-[clamp(2.3rem,4.5vw,4.35rem)] leading-[1.01] font-medium tracking-[-0.07em]"
            >
              Have a model change you want to test out?
            </h2>
          </div>
          <div class="max-w-[680px]">
            <p class="text-base leading-relaxed text-white/80">
              I am looking to speak with technical founders and CTOs running
              production AI workloads who expect to evaluate a model, provider,
              prompt or retrieval change in the next 90 days.
            </p>
            <a
              href="mailto:james@bayly.xyz?subject=AI%20Change%20Assurance"
              class="mt-9 flex items-center justify-between gap-5 border-b border-white/35 py-5 font-heading text-[clamp(1.25rem,2.4vw,2rem)] font-medium tracking-[-0.055em] text-brand-aqua no-underline"
            >
              <span>james@bayly.xyz</span>
              <ArrowRight className="size-5 shrink-0" />
            </a>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>
